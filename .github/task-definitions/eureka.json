{
  "family": "notifyme-eureka",
  "taskRoleArn": "",
  "networkMode": "host",
  "requiresCompatibilities": ["EC2"],
  "containerDefinitions": [
    {
      "name": "notifyme-eureka",
      "image": "PLACEHOLDER_IMAGE_URI",
      "portMappings": [
        {
          "containerPort": 8761,
          "hostPort": 8761,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "dev"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notifyme-eureka",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
